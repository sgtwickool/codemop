+def search_users(conn, name_fragment, limit=50):
+    """Users whose name contains `name_fragment`"""
+    cur = conn.cursor()
+    cur.execute(
+        f"SELECT id, name FROM users WHERE name ILIKE '%{name_fragment}%' LIMIT {int(limit)}"
+    )
+    return cur.fetchall()
