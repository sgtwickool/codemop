# Production image for the CodeMop webhook server. Build it from the repository root, since
# the server uses the codemop package there:
#   docker build -f server/Dockerfile.prod -t codemop-server .
FROM python:3.14-slim

# Run as a non-root user
RUN useradd -m appuser
USER appuser
WORKDIR /app

ENV PATH=/home/appuser/.local/bin:$PATH \
    PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    DEBUG=False

# The server's pinned dependencies first, so this layer is cached between code changes
COPY --chown=appuser:appuser server/requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# The codemop package (its dependencies are already installed, pinned, above)
COPY --chown=appuser:appuser pyproject.toml README.md LICENSE /tmp/codemop/
COPY --chown=appuser:appuser src /tmp/codemop/src
RUN pip install --user --no-cache-dir --no-deps /tmp/codemop && rm -rf /tmp/codemop

# The server itself
COPY --chown=appuser:appuser server/src /app/src

# Health check (note: Podman uses OCI format, Docker uses Docker format)
# python:slim has no curl, so use the standard library
HEALTHCHECK --interval=30s --timeout=3s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health', timeout=2)" || exit 1

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
