---
import { Code } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Print from "../components/Print.astro";
import PrintFilters from "../components/PrintFilters.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SummaryDemo from "../components/SummaryDemo.astro";
import "../styles/mascot.css";

const github = "https://github.com/sgtwickool/codemop";
const tagline =
  "AI code review for pull requests, with the model of your choice. Tick the fixes you want and it commits them.";
const reviewStep = "- uses: sgtwickool/codemop@v1\n  with:\n    api-key: ${{ secrets.ANTHROPIC_API_KEY }}";

// The loop's steps, each labelled with when it happens (as gregkemp.dev labels its work with dates)
const loop = [
  {
    print: "mop",
    when: "On every push",
    title: "Review",
    text: "A comment on each issue, with a one-click fix where there is one. It reads the code around each change too, and where the changed code is used, because a change can be right in itself and break what calls it.",
    link: "/quickstart/",
  },
  {
    print: "respond",
    when: "In the summary",
    title: "Respond",
    text: "One summary lists every issue. Tick the fixes you want, then Commit the ticked fixes, and they land as one commit. Resolve a conversation to dismiss it, or reply /codemop learn to teach the whole repository.",
    link: "/responding/",
  },
  {
    print: "gate",
    when: "Before merging",
    title: "Merge",
    text: "An optional merge check fails while bugs or security issues are open, and passes once they're fixed or dismissed. Make it required, and a known bug doesn't merge unnoticed.",
    link: "/merge-check/",
  },
] as const;
---

<StarlightPage
  frontmatter={{
    title: "CodeMop: AI code review for pull requests",
    description: tagline,
    template: "splash",
    hero: {
      title: "CodeMop",
      tagline,
      actions: [
        { text: "Quick start", link: "/quickstart/" },
        { text: "Source on GitHub", link: github },
      ],
    },
  }}
>
  <PrintFilters />

  <section class="not-content" aria-labelledby="loop">
    <SectionHeading id="loop" text="The review loop" />
    <ol class="steps">
      {
        loop.map((step) => (
          <li>
            <a class="step" href={step.link}>
              <Print name={step.print} />
              <p class="label">{step.when}</p>
              <h3>{step.title}</h3>
              <p class="step-text">{step.text}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="not-content" aria-labelledby="real">
    <SectionHeading id="real" text="A real review" />
    <p class="intro">
      CodeMop's review of its own <a href={`${github}/pull/20`}>pull request #20</a>, a 1,450-line refactor (a typical
      pull request costs a few cents). Tick the fix, then <strong>Commit the ticked fixes</strong>.
    </p>
    <SummaryDemo />
  </section>

  <section class="not-content" aria-labelledby="why">
    <SectionHeading id="why" text="Why CodeMop" />
    <!-- Each over a rule in one of the inks, as gregkemp.dev's product lists -->
    <dl class="reasons">
      <div>
        <dt>Safe on any pull request</dt>
        <dd>
          It reads the diff through GitHub's API and never checks out or runs the pull request's code, so it can hold
          your key on a fork's PR, from anyone. Agents that run tools on the code can't.
        </dd>
      </div>
      <div>
        <dt>Cheap enough for every push</dt>
        <dd>
          A few cents and a few seconds a review with the default model, chosen by
          an <a href={`${github}/blob/master/evals/review/README.md`}>eval</a> in which 99% of its comments were right.
        </dd>
      </div>
      <div>
        <dt>Your model, your key</dt>
        <dd>
          Anthropic, Mistral, OpenAI, OpenRouter, any OpenAI-compatible endpoint, or a local model. No CodeMop server:
          your code goes only to the provider you choose.
        </dd>
      </div>
      <div>
        <dt>It learns, and you can see what</dt>
        <dd>
          What it's taught goes in a file in your repository, which you can read and edit. Re-reviews look at the new
          commits only, and resolve conversations once the code is fixed.
        </dd>
      </div>
    </dl>
  </section>

  <section class="not-content" aria-labelledby="setup">
    <SectionHeading id="setup" text="Set up in two minutes" />
    <ol class="setup">
      <li>Add your model provider's API key as a repository secret, e.g. <code>ANTHROPIC_API_KEY</code>.</li>
      <li>
        Add CodeMop's workflow, <code>.github/workflows/codemop.yml</code>, from
        the <a href="/quickstart/">quick start</a>. Its review step is just:
        <Code code={reviewStep} lang="yaml" />
      </li>
    </ol>
    <p class="intro">The next pull request gets a review.</p>
  </section>

  <p class="not-content credit">
    Made by <a href="https://gregkemp.dev">Greg Kemp</a>. MIT licensed, on <a href={github}>GitHub</a>.
  </p>
</StarlightPage>

<script>
  import { bindMascot } from "../scripts/mascot";

  bindMascot();
</script>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-top: clamp(5rem, 10vw, 8rem);
  }
  .intro {
    margin: 0;
    max-width: 36em;
    font-size: 1.1rem;
    color: var(--ink-soft);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2.5rem 2rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: inherit;
    text-decoration: none;
  }
  .step :global(.print) {
    margin-bottom: 0.4rem;
  }
  .step h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--ink);
  }
  .step:hover h3 {
    color: var(--link);
  }
  .step-text {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .reasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 2rem 3rem;
    margin: 0.5rem 0 0;
  }
  .reasons div {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.75rem;
    border-top: 2px solid var(--ink-strong);
  }
  .reasons div:nth-child(even) {
    border-top-color: var(--ink-line);
  }
  .reasons dt {
    font-family: var(--font-sans);
    font-weight: 800;
    color: var(--ink);
  }
  .reasons dd {
    margin: 0;
    color: var(--ink-soft);
  }
  .setup {
    display: grid;
    gap: 0.8rem;
    margin: 0.5rem 0 0;
    padding-left: 1.3rem;
  }
  .setup li {
    min-width: 0;
  }
  .setup :global(.expressive-code) {
    margin-top: 0.6rem;
  }
  .credit {
    margin: clamp(5rem, 10vw, 8rem) 0 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
