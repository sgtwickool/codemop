---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { moppyHtml } from "../components/home/moppy/scene";
import SummaryDemo from "../components/home/SummaryDemo.astro";
import "../components/home/moppy/moppy.css";

const github = "https://github.com/sgtwickool/codemop";
const description =
  "AI code review for pull requests, with the model of your choice. Tick the fixes you want and it commits them.";
const reviewStep = "- uses: sgtwickool/codemop@v1\n  with:\n    api-key: ${{ secrets.ANTHROPIC_API_KEY }}";
const tape = Array(16).fill("Caution ◆ Fixes being committed ◆ ").join("");

// The loop's steps, each with when it happens, and a sign for it: drawn in the sign's ink
// (currentColor), on its yellow plate
const loop = [
  {
    sign: '<circle cx="31" cy="31" r="13" fill="#fff" stroke="currentColor" stroke-width="5"/><path d="M41 41 L54 54" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>',
    when: "On every push",
    title: "Review",
    text: "A comment on each issue, with a one-click fix where there is one. It reads the code around each change too, and where the changed code is used, because a change can be right in itself and break what calls it.",
    link: "/quickstart/",
  },
  {
    sign: '<rect x="17" y="17" width="38" height="38" rx="7" fill="#fff" stroke="currentColor" stroke-width="4.5"/><path d="M25 37 L33 45 L48 27" stroke="currentColor" stroke-width="5.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>',
    when: "In the summary",
    title: "Respond",
    text: "One summary lists every issue. Tick the fixes you want, then Commit the ticked fixes, and they land as one commit. Resolve a conversation to dismiss it, or reply /codemop learn to teach the whole repository.",
    link: "/responding/",
  },
  {
    sign: '<path d="M16 56 V22 M56 56 V22" stroke="currentColor" stroke-width="5" stroke-linecap="round"/><rect x="16" y="30" width="40" height="10" fill="currentColor"/><path class="stripes" d="M22 30 l8 10 M34 30 l8 10 M46 30 l8 10" stroke-width="4"/>',
    when: "Before merging",
    title: "Merge",
    text: "An optional merge check fails while bugs or security issues are open, and passes once they're fixed or dismissed. Make it required, and a known bug doesn't merge unnoticed.",
    link: "/merge-check/",
  },
];
---

<StarlightPage
  frontmatter={{
    title: "CodeMop: AI code review for pull requests",
    description,
    template: "splash",
    hero: {
      title: "Code review that <mark>cleans up</mark> after itself.",
      tagline: "Reviews your pull requests with the model of your choice. Tick the fixes you want and it commits them.",
      actions: [
        { text: "Quick start", link: "/quickstart/" },
        { text: "Source on GitHub", link: github, variant: "secondary" },
      ],
      image: { html: moppyHtml },
    },
  }}
>
  <div class="tape-wrap not-content" aria-hidden="true" data-tape><div class="tape"><span>{tape}</span></div></div>

  <section class="not-content" aria-labelledby="loop">
    <h2 id="loop">The review loop</h2>
    <ol class="steps">
      {
        loop.map((step, i) => (
          <li>
            <a class="card step" href={step.link}>
              <div class="step-top">
                <svg class="sign" width="64" height="64" viewBox="0 0 72 72" aria-hidden="true">
                  <rect class="plate" x="3" y="3" width="66" height="66" rx="14" stroke-width="3" />
                  <Fragment set:html={step.sign} />
                </svg>
                <span class="step-number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              </div>
              <p class="label">{step.when}</p>
              <h3>{step.title}</h3>
              <p class="step-text">{step.text}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="not-content real" aria-labelledby="real">
    <div class="real-intro">
      <h2 id="real">A real review</h2>
      <p class="intro">
        CodeMop's review of its own <a href={`${github}/pull/20`}>pull request #20</a>, a 1,450-line refactor (a
        typical pull request costs a few cents). Tick the fix, then <strong>Commit the ticked fixes</strong>.
      </p>
    </div>
    <div class="real-demo">
      <SummaryDemo />
      <span class="sticker" aria-hidden="true">about $0.36</span>
    </div>
  </section>

  <section class="not-content" aria-labelledby="why">
    <h2 id="why">Why CodeMop</h2>
    <dl class="reasons">
      <div class="card">
        <dt>Safe on any pull request</dt>
        <dd>
          It reads the diff through GitHub's API and never checks out or runs the pull request's code, so it can hold
          your key on a fork's PR, from anyone. Agents that run tools on the code can't.
        </dd>
      </div>
      <div class="card">
        <dt>Cheap enough for every push</dt>
        <dd>
          A few cents and a few seconds a review with the default model, chosen by
          an <a href={`${github}/blob/master/evals/review/README.md`}>eval</a> in which 99% of its comments were right.
        </dd>
      </div>
      <div class="card">
        <dt>Your model, your key</dt>
        <dd>
          Anthropic, Mistral, OpenAI, OpenRouter, any OpenAI-compatible endpoint, or a local model. No CodeMop server:
          your code goes only to the provider you choose.
        </dd>
      </div>
      <div class="card">
        <dt>It learns, and you can see what</dt>
        <dd>
          What it's taught goes in a file in your repository, which you can read and edit. Re-reviews look at the new
          commits only, and resolve conversations once the code is fixed.
        </dd>
      </div>
    </dl>
  </section>

  <section class="not-content setup" aria-labelledby="setup">
    <div class="setup-text">
      <h2 id="setup">Set up in two minutes</h2>
      <ol>
        <li>Add your model provider's API key as a repository secret, e.g. <code>ANTHROPIC_API_KEY</code>.</li>
        <li>
          Add CodeMop's workflow, <code>.github/workflows/codemop.yml</code>, from the <a href="/quickstart/">quick start</a>.
          Its review step is just this.
        </li>
      </ol>
      <p>The next pull request gets a review.</p>
    </div>
    <div class="setup-code">
      <pre><code><span class="key">- uses:</span> sgtwickool/codemop@v1
  <span class="key">with:</span>
    <span class="key">api-key:</span> {"${{ secrets.ANTHROPIC_API_KEY }}"}</code></pre>
      <button type="button" class="copy" data-copy={reviewStep}>Copy</button>
    </div>
  </section>

  <footer class="not-content credit">
    <span>Made by <a href="https://gregkemp.dev">Greg Kemp</a>. MIT licensed, on <a href={github}>GitHub</a>.</span>
    <span>Mind the wet floor.</span>
  </footer>
</StarlightPage>

<script>
  import { playMoppy } from "../components/home/moppy/play";

  playMoppy();

  // The caution tape creeps along only while it's on screen
  const tape = document.querySelector("[data-tape]");
  if (tape) new IntersectionObserver(([entry]) => tape.classList.toggle("paused", !entry.isIntersecting)).observe(tape);

  // The setup step's copy button
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = "Copied";
      setTimeout(() => (button.textContent = "Copy"), 1500);
    });
  }
</script>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    margin-top: clamp(5rem, 10vw, 7.5rem);
  }
  h2 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .intro {
    margin: 0;
    max-width: 34em;
    font-size: 1.1rem;
    color: var(--ink-soft);
  }

  /* Caution tape across the page, a little askew, creeping along (clipped at the page's edges) */
  .tape-wrap {
    margin: 2rem calc(50% - 50vw) 0;
    padding-block: 1rem;
    overflow: clip;
  }
  .tape {
    margin-inline: -1rem;
    padding: 0.55rem 0;
    transform: rotate(-1.4deg);
    background: var(--yellow);
    color: var(--on-yellow);
    border-block: 3px solid var(--night);
    white-space: nowrap;
    overflow: hidden;
    font-family: var(--font-label);
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tape span {
    display: inline-block;
  }
  :global(.motion) .tape span {
    animation: tape 60s linear infinite;
  }
  .tape-wrap.paused span {
    animation-play-state: paused;
  }
  @keyframes tape {
    to {
      transform: translateX(-50%);
    }
  }

  /* The loop */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    display: flex;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.75rem;
    color: inherit;
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .step:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 var(--shadow);
  }
  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }
  .sign {
    color: var(--night);
  }
  .sign .plate {
    fill: var(--yellow);
    stroke: currentColor;
  }
  .sign :global(.stripes) {
    stroke: var(--yellow);
  }
  .step-number {
    font-family: var(--font-label);
    font-weight: 800;
    font-size: 2.5rem;
    color: var(--rule);
  }
  .step h3 {
    margin: 0;
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .step-text {
    margin: 0;
    color: var(--ink-soft);
  }

  /* The real review, with its price on a sticker */
  .real {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    align-items: center;
    gap: 2.5rem 3rem;
  }
  .real-intro {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .real-demo {
    position: relative;
    min-width: 0;
  }
  .sticker {
    position: absolute;
    top: -1.1rem;
    right: -0.4rem;
    transform: rotate(5deg);
    padding: 0.4rem 0.9rem;
    background: var(--water);
    color: var(--on-yellow);
    border: 2.5px solid var(--night);
    border-radius: 12px;
    box-shadow: 3px 3px 0 var(--night);
    font-weight: 700;
  }
  @media (max-width: 56rem) {
    .real {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Why */
  .reasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: 1.5rem;
    margin: 0;
  }
  .reasons .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.6rem;
    border-top-width: 10px;
    border-top-color: var(--yellow);
    box-shadow: none;
  }
  .reasons dt {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .reasons dd {
    margin: 0;
    color: var(--ink-soft);
  }

  /* Setting up, on a night-dark panel in both themes, with its own palette */
  .setup {
    --setup-text: #edeef1;
    --setup-soft: #b9bcc4;
    --setup-code: #2a2d35;
    --setup-pre: #23262d;
    --setup-button: #2f333b;
    --setup-button-edge: #4a4f5a;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 2rem 3rem;
    padding: clamp(1.75rem, 4vw, 3.25rem);
    background: var(--night);
    color: var(--setup-text);
    border-radius: 28px;
    outline: 2px solid var(--edge);
  }
  .setup h2 {
    color: var(--yellow);
  }
  .setup-text {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .setup ol {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding-left: 1.4rem;
  }
  .setup p {
    margin: 0;
    color: var(--setup-soft);
  }
  .setup code {
    background: var(--setup-code);
    color: var(--setup-text);
  }
  .setup a {
    color: var(--yellow);
  }
  .setup-code {
    position: relative;
    min-width: 0;
  }
  .setup pre {
    margin: 0;
    padding: 1.5rem 1.6rem;
    background: var(--setup-pre);
    border: 2.5px solid var(--yellow);
    border-radius: 18px;
    overflow-x: auto;
    font-family: var(--sl-font-mono);
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--setup-text);
  }
  .setup pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .setup .key {
    color: var(--yellow);
  }
  .copy {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    min-height: 2.25rem;
    padding: 0 0.8rem;
    font: 600 0.85rem var(--font-body);
    color: var(--setup-text);
    background: var(--setup-button);
    border: 1.5px solid var(--setup-button-edge);
    border-radius: 9px;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--yellow);
  }
  @media (max-width: 56rem) {
    .setup {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .credit {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin: clamp(4rem, 8vw, 6rem) 0 1rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
