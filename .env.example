# GitHub Webhook Configuration
# Required unless APP_ENV=development. Use the same value as the webhook's secret on GitHub,
# e.g. generate one with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# GitHub API, used to fetch PR diffs
# Needed for private repos; optional for public ones (it raises the rate limit from 60 to 5,000
# requests/hour). Use a fine-grained token limited to the repos you review, with read-only
# "Pull requests" and "Contents" permissions.
GITHUB_TOKEN=
# Only change this for GitHub Enterprise Server, e.g. https://github.example.com/api/v3
GITHUB_API_URL=https://api.github.com

# Database Configuration
DATABASE_URL=postgresql://codemop:codemop@localhost:5432/codemop

# AI review (through the codemop package)
# AI_PROVIDER: anthropic, mistral, openai, openrouter, ollama or openai-compatible
# AI_MODEL: leave empty for the provider's default (anthropic: claude-opus-5-5, mistral: codestral-latest)
# AI_BASE_URL: only for openai-compatible, or a self-hosted endpoint
# AI_API_KEY: the provider's API key (ollama needs none)
AI_PROVIDER=anthropic
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=your_ai_api_key_here

# API Authentication
# Required unless APP_ENV=development; clients send it as "Authorization: Bearer <key>"
API_KEY=your_secure_api_key_here

# Application Configuration
# development: secrets are optional and webhook signatures aren't checked if the secret is unset.
# Anything else (the default if unset is production): the server won't start without both secrets.
APP_ENV=development
DEBUG=True
PORT=8000

# Browser origins allowed to call the API, comma-separated. Leave empty unless you run a browser
# dashboard: GitHub and API clients (like the CLI) don't need CORS
CORS_ORIGINS=
