# GitHub Webhook Configuration
# Required unless APP_ENV=development. Use the same value as the webhook's secret on GitHub,
# e.g. generate one with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Database Configuration
DATABASE_URL=postgresql://codemop:codemop@localhost:5432/codemop

# AI API Configuration
AI_API_KEY=your_ai_api_key_here
AI_API_URL=https://api.mistral.ai/v1/chat/completions
AI_MODEL=codestral-latest

# API Authentication
# Required unless APP_ENV=development; clients send it as "Authorization: Bearer <key>"
API_KEY=your_secure_api_key_here

# Application Configuration
# development: secrets are optional and webhook signatures aren't checked if the secret is unset.
# Anything else (the default if unset is production): the server won't start without both secrets.
APP_ENV=development
DEBUG=True
PORT=8000

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=1.0